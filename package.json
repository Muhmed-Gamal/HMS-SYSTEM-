{
  "name": "hms-barcode-system",
  "version": "1.0.0",
  "description": "HMS Barcode Inventory System Backend and Frontend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:frontend": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "license:gen": "node generate_license.js",
    "license:month": "node generate_license.js --months 1",
    "license:year": "node generate_license.js --years 1",
    "package:client": "node package_client_release.js",
    "clean:db": "node reset_database_clean.js",
    "verify": "node verify_system.js",
    "test": "node verify_system.js"
  },
  "keywords": [
    "barcode",
    "inventory",
    "express",
    "mssql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "mssql": "^12.7.4",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.9.0",
    "nodemon": "^1.14.10"
  }
}
