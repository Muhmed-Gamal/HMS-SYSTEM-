# ===================================================================
# HMS Industrial Barcode Tracking System - Environment Configuration
# ===================================================================
# ملاحظة: لا تعبّى هذه القيم يدوياً — يملأها برنامج الإعداد التلقائي
#          عند تشغيل start_system.bat أول مرة على أي جهاز عميل.
# ===================================================================

# منفذ تشغيل النظام
PORT=3000

# ─── إعدادات قاعدة البيانات (يُعبّئها الإعداد التلقائي تلقائياً) ───
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_ENCRYPT=false

# هل تم الإعداد على هذا الجهاز؟ (يُعيَّن تلقائياً بواسطة first_run_setup.js)
SETUP_DONE=false

# نمط الترخيص:
# false = وضع العميل (يتطلب ملف ترخيص hms.lic لتشغيل النظام)
# true  = وضع المطور العام (مفعل مدى الحياة بدون ملفات ترخيص)
GENERAL_EDITION=false

# اسم وهوية الشركة / المصنع
# ─── ملاحظة مهمة: اكتب اسم المصنع هنا بالإنجليزية لتوليد اسم قاعدة البيانات ───
COMPANY_NAME_AR=اسم الشركة بالعربية
COMPANY_NAME_EN=CompanyName

# المفتاح الأمني لتشفير جلسات التوكن (JWT)
JWT_SECRET=your_jwt_secret_key_here
